  },
  "components": {
    "schemas": {
      "WarningLevel": {
        "type": "string",
        "enum": [
          "NORMAL",
          "WARNING",
          "CRITICAL",
          "UNKNOWN"
        ]
      },
      "StationStatus": {
        "type": "string",
        "enum": [
          "ONLINE",
          "MAINTENANCE",
          "OFFLINE"
        ]
      },
      "Location": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "latitude",
          "longitude"
        ],
        "properties": {
          "latitude": {
            "type": "number",
            "format": "double",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "format": "double",
            "minimum": -180,
            "maximum": 180
          }
        }
      },
      "Station": {
        "type": "object",
        "additionalProperties": false,
        "xml": {
          "name": "station"
        },
        "required": [
          "id",
          "name",
          "river",
          "location",
          "normalWaterLevel",
          "warningWaterLevel",
          "criticalWaterLevel",
          "isActive"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,40}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "river": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "location": {
            "$ref": "#/components/schemas/Location"
          },
          "normalWaterLevel": {
            "type": "number",
            "format": "double",
            "minimum": 0
          },
          "warningWaterLevel": {
            "type": "number",
            "format": "double",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "criticalWaterLevel": {
            "type": "number",
            "format": "double",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "isActive": {
            "type": "boolean"
          }
        },
        "description": "0 <= normalWaterLevel < warningWaterLevel < criticalWaterLevel. Wasserstände in cm."
      },
      "StationPatch": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "xml": {
          "name": "station"
        },
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "river": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "location": {
            "$ref": "#/components/schemas/Location"
          },
          "normalWaterLevel": {
            "type": "number",
            "format": "double",
            "minimum": 0
          },
          "warningWaterLevel": {
            "type": "number",
            "format": "double",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "criticalWaterLevel": {
            "type": "number",
            "format": "double",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "isActive": {
            "type": "boolean"
          }
        },
        "description": "Teilaktualisierung; ausgelassene Felder bleiben erhalten. null und id sind unzulässig. location wird vollständig ersetzt."
      },
      "Measurement": {
        "type": "object",
        "xml": {
          "name": "measurement"
        },
        "properties": {
          "stationId": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "waterLevel": {
            "type": "number",
            "format": "double",
            "description": "cm"
          },
          "flowRate": {
            "type": "number",
            "format": "double",
            "description": "m³/s"
          },
          "rainfall": {
            "type": "number",
            "format": "double",
            "description": "Stundenwert in mm/h"
          },
          "temperature": {
            "type": "number",
            "format": "double",
            "description": "°C"
          },
          "batteryLevel": {
            "type": "number",
            "format": "double",
            "minimum": 0,
            "maximum": 100
          },
          "status": {
            "$ref": "#/components/schemas/StationStatus"
          },
          "warningLevel": {
            "$ref": "#/components/schemas/WarningLevel"
          }
        }
      },
      "Statistics": {
        "type": "object",
        "xml": {
          "name": "statistics"
        },
        "properties": {
          "stationId": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          },
          "minWaterLevel": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "maxWaterLevel": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "averageWaterLevel": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "averageFlowRate": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "totalRainfall": {
            "type": "number",
            "format": "double",
            "description": "Arithmetische Summe der Stundenwerte (mm/h), keine zeitliche Integration."
          },
          "warningCount": {
            "type": "integer",
            "description": "Nur WARNING"
          },
          "criticalCount": {
            "type": "integer",
            "description": "Nur CRITICAL"
          }
        }
      },
      "ApiError": {
        "type": "object",
        "xml": {
          "name": "error"
        },
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "integer"
          },
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        }
      },
      "Stations": {
        "type": "object",
        "xml": {
          "name": "stations"
        },
        "properties": {
          "stations": {
            "type": "array",
            "xml": {
              "wrapped": false
            },
            "items": {
              "$ref": "#/components/schemas/Station",
              "xml": {
                "name": "station"
              }
            }
          }
        }
      },
      "Measurements": {
        "type": "object",
        "xml": {
          "name": "measurements"
        },
        "properties": {
          "measurements": {
            "type": "array",
            "xml": {
              "wrapped": false
            },
            "items": {
              "$ref": "#/components/schemas/Measurement",
              "xml": {
                "name": "measurement"
              }
            }
          }
        }
      },
      "Alerts": {
        "type": "object",
        "xml": {
          "name": "alerts"
        },
        "properties": {
          "alerts": {
            "type": "array",
            "xml": {
              "wrapped": false
            },
            "items": {
              "$ref": "#/components/schemas/Measurement",
              "xml": {
                "name": "measurement"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Admin-Schlüssel aus FLOOD_ADMIN_KEY; optionaler Viewer-Schlüssel aus FLOOD_VIEWER_KEY besitzt keine Schreibrechte."
      }
    }
  }
}
